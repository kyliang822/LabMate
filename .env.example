POSTGRES_USER=labmate
POSTGRES_DB=labmate
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql://labmate:replace-with-local-secret@localhost/labmate
CELERY_BROKER_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads

# Real provider; use the /v1 base URL (the worker appends /embeddings).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
